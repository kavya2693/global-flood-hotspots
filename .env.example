# Optional. The committed dataset needs none of these; the scripts in scripts/
# use them to re-derive rainfall and terrain from the primary archives.

# Copernicus Climate Data Store, for ERA5 reanalysis rainfall.
# Register at https://cds.climate.copernicus.eu/ and copy the key from your profile.
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# NASA Earthdata, for GPM IMERG half-hourly precipitation.
# Register at https://urs.earthdata.nasa.gov/
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# OpenTopography, for Copernicus GLO-30 elevation tiles.
# Register at https://portal.opentopography.org/
OPENTOPOGRAPHY_API_KEY=
